# Copy these settings into server/.env. Keep real credentials out of source control.
# Database connection string; the database name determines where accounts are stored.
MONGO_URI=mongodb://127.0.0.1:27017/a-grain-of-salt
# A long random secret used to sign login cookies. Changing it signs everyone out.
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Frontend URL used for CORS and password reset links.
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional locally; required for production recovery email:
RESEND_API_KEY=
EMAIL_FROM=
